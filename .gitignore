# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# content
/public/images
/public/temp

# 忽略 content 下所有内容
content/*

# 只打开到 dev 的路径（逐级解锁）
!content/developer
content/developer/*

!content/developer/dev
!content/developer/dev/**

!.gitignore

/.archive
/.claude

# dev index dumps
/.logs

# ----- default -----

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# 旧框架产物及新静态构建产物
/.next/
/out/

# production
/dist/
/.build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python 运行缓存与临时日志
__pycache__/
*.pyc
/nohup.out
