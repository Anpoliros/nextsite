{
  "name": "weblog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync-articles": "scripts/sync_articles.sh",
    "dev": "tsx build/dev.ts",
    "build": "tsc --noEmit && tsx build/generate.ts",
    "start": "node scripts/static-server.mjs",
    "deploy": "scripts/deploy_articles.sh",
    "ascii:preview": "node scripts/ascii-preview.mjs",
    "hook:articles": "node scripts/articles_webhook.mjs",
    "hook:deploy-articles": "scripts/deploy_articles.sh",
    "stop": "pm2 stop nextsite",
    "log": "pm2 logs nextsite",
    "lint": "eslint src build scripts/*.mjs tests/*.mjs",
    "preview": "node scripts/static-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "preview:new": "pm2 startOrRestart preview.config.cjs --only weblog-new --update-env"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-pretty-code": "^0.14.3",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.34.5",
    "shiki": "^4.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.5.0",
    "playwright": "^1.63.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  },
  "type": "module"
}
